    "@mui/x-tree-view": "^8.22.0",
    "@supabase/supabase-js": "^2.39.3",
    "@tanstack/react-query": "^5.90.12",
    "@xyflow/react": "^12.0.0",
    "axios": "^1.6.7",
    "lucide-react": "^0.330.0",
    "motion": "^12.29.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
